{
  "title": "LLM Gateway Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {"type":"stat","title":"Requests / min","gridPos":{"x":0,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(rate(llm_gateway_requests_total[1m]))*60","legendFormat":"rpm"}]},
    {"type":"timeseries","title":"Latency p95","gridPos":{"x":6,"y":0,"w":12,"h":4},"targets":[{"expr":"histogram_quantile(0.95, sum by (le, model) (rate(llm_gateway_request_latency_seconds_bucket[5m])))","legendFormat":"{{model}}"}]},
    {"type":"timeseries","title":"Error Rate","gridPos":{"x":18,"y":0,"w":6,"h":4},"targets":[{"expr":"sum(rate(llm_gateway_errors_total[5m])) / clamp_min(sum(rate(llm_gateway_requests_total[5m])), 1)","legendFormat":"error rate"}]},
    {"type":"timeseries","title":"Tokens / sec","gridPos":{"x":0,"y":4,"w":12,"h":5},"targets":[{"expr":"sum by (model,type) (rate(llm_gateway_tokens_total[5m]))","legendFormat":"{{model}} {{type}}"}]},
    {"type":"timeseries","title":"Estimated Cost / hour","gridPos":{"x":12,"y":4,"w":12,"h":5},"targets":[{"expr":"sum(rate(llm_gateway_estimated_cost_usd_total[1h]))*3600","legendFormat":"USD/hr"}]},
    {"type":"timeseries","title":"Quality Score","gridPos":{"x":0,"y":9,"w":12,"h":5},"targets":[{"expr":"avg by (model) (rate(llm_gateway_quality_score_sum[10m]) / clamp_min(rate(llm_gateway_quality_score_count[10m]),1))","legendFormat":"{{model}}"}]},
    {"type":"timeseries","title":"Discovered Models","gridPos":{"x":12,"y":9,"w":12,"h":5},"targets":[{"expr":"llm_gateway_discovered_models","legendFormat":"models"}]}
  ]
}
